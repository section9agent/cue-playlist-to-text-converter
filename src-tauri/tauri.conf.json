{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cue Playlist to Text Converter",
  "version": "0.1.0",
  "identifier": "dev.tracklisttool.discogs",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cue/Playlist to Text Converter",
        "width": 1000,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Turn cue sheets and playlists into text tracklists and CSV files",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzODI5NUQyODdFQjk2RjgKUldUNGx1dUgwcFdDRTcvTmd5ZzBwMmZzenVFU2JBbnI5cmtjNXZNakpsNnNHdWtaRkwvOGt5YU8K",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
